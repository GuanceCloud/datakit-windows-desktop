<Window x:Class="WpfSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guance RUM WPF Sample"
        Width="480"
        Height="280">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="Guance RUM WPF Sample" FontSize="22" Margin="0,0,0,16" />
        <Button x:Name="LoadButton" Content="Send HTTP request" Padding="12,8" Click="OnLoadClicked" />
        <Button x:Name="ErrorButton" Content="Generate error" Padding="12,8" Margin="0,12,0,0" Click="OnErrorClicked" />
    </StackPanel>
</Window>
