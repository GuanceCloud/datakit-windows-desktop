{
  "name": "guance-windows-electron-full-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Electron RUM preview with the Bridge EXE owning the Windows SDK",
  "main": "main.cjs",
  "scripts": {
    "electron:install": "install-electron",
    "native:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-native.ps1",
    "start": "npm run electron:install && electron .",
    "verify": "npm run verify:native && npm run verify:electron",
    "verify:native": "node scripts/verify-native.cjs",
    "verify:electron": "npm run electron:install && node scripts/verify-electron.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check main.cjs && node --check renderer.js && npm test"
  },
  "dependencies": {
    "@cloudcare/browser-rum": "3.3.6"
  },
  "devDependencies": {
    "electron": "43.4.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
