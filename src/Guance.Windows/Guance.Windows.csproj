<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net6.0-windows10.0.17763.0;net8.0-windows10.0.17763.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Guance.Windows</PackageId>
    <Version>0.1.0</Version>
    <Description>Guance Windows observability SDK for RUM, tracing, logging, Session Replay, and native desktop integrations.</Description>
    <PackageProjectUrl>https://github.com/GuanceCloud/datakit-windows-desktop</PackageProjectUrl>
    <PackageReleaseNotes>0.1.0-alpha.7 enables managed intake compression by default and fixes managed and bundled Native uploads to emit zlib-wrapped Deflate bodies compatible with HTTP receivers.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Guance;Observability;RUM;Tracing;Logging;SessionReplay;Dataway;DataKit;Windows;WPF;WinForms;WinUI</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-windows'))">
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" Condition="Exists('../../.git')" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../Guance.Windows.Native/bin/win-x64/guance_windows_native.dll"
          Condition="Exists('../Guance.Windows.Native/bin/win-x64/guance_windows_native.dll')"
          Pack="true"
          PackagePath="runtimes/win-x64/native/" />
    <None Include="../Guance.Windows.Native/bin/win-arm64/guance_windows_native.dll"
          Condition="Exists('../Guance.Windows.Native/bin/win-arm64/guance_windows_native.dll')"
          Pack="true"
          PackagePath="runtimes/win-arm64/native/" />
    <None Include="../Guance.Windows.Native/bin/win-x86/guance_windows_native.dll"
          Condition="Exists('../Guance.Windows.Native/bin/win-x86/guance_windows_native.dll')"
          Pack="true"
          PackagePath="runtimes/win-x86/native/" />
  </ItemGroup>
</Project>
