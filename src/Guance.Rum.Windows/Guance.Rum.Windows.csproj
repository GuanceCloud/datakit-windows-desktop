<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net6.0-windows10.0.17763.0;net8.0-windows10.0.17763.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Guance.Rum.Windows</PackageId>
    <Version>0.1.0</Version>
    <Description>Guance Windows desktop RUM SDK for WPF, WinForms, WinUI, and native desktop integrations.</Description>
    <PackageProjectUrl>https://github.com/GuanceCloud/datakit-windows-desktop</PackageProjectUrl>
    <PackageReleaseNotes>Initial Windows desktop SDK with native runtime assets and the five core RUM measurements. Session Replay is available as an opt-in experimental capability and remains disabled by default.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Guance;RUM;Dataway;DataKit;Windows;WPF;WinForms;WinUI</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-windows'))">
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="7.0.20" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" Condition="Exists('../../.git')" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../Guance.Rum.NativeCore/bin/win-x64/guance_rum_native.dll"
          Condition="Exists('../Guance.Rum.NativeCore/bin/win-x64/guance_rum_native.dll')"
          Pack="true"
          PackagePath="runtimes/win-x64/native/" />
    <None Include="../Guance.Rum.NativeCore/bin/win-arm64/guance_rum_native.dll"
          Condition="Exists('../Guance.Rum.NativeCore/bin/win-arm64/guance_rum_native.dll')"
          Pack="true"
          PackagePath="runtimes/win-arm64/native/" />
    <None Include="../Guance.Rum.NativeCore/bin/win-x86/guance_rum_native.dll"
          Condition="Exists('../Guance.Rum.NativeCore/bin/win-x86/guance_rum_native.dll')"
          Pack="true"
          PackagePath="runtimes/win-x86/native/" />
  </ItemGroup>
</Project>
