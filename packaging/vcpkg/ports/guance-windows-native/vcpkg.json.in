{
  "name": "guance-windows-native",
  "version-semver": "@VERSION@",
  "description": "Guance.Windows.Native observability SDK for RUM, distributed tracing, and logging",
  "homepage": "https://github.com/GuanceCloud/datakit-windows-desktop",
  "documentation": "https://github.com/GuanceCloud/datakit-windows-desktop#readme",
  "license": "Apache-2.0",
  "supports": "windows & x64 & !uwp",
  "features": {
    "electron-adapter": {
      "description": "Install the SDK-owned Electron JavaScript adapter"
    },
    "electron-bridge": {
      "description": "Install the Electron adapter and native Bridge EXE for Full Mode",
      "dependencies": [
        {
          "name": "guance-windows-native",
          "default-features": false,
          "features": [
            "electron-adapter"
          ]
        }
      ]
    }
  },
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ]
}
